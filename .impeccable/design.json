  "narrative": {
    "northStar": "Personal tools",
    "overview": "An established personal site for finding Anders’s projects and tools. Its pale sage ground, deep ink, teal links and serif reading text create a restrained, readable setting for project work. The analytics workspace inherits that identity and uses the existing display stack for compact forms, tables and measurements.\n\nThis is a record of the implemented system, not a replacement identity. The source authority is assets/style.css; stats/stats.css supplies the denser workspace rules. Both follow the operating system’s light/dark preference. No raster assets were introduced by the statistics extension.",
    "keyCharacteristics": [
      "Sage-tinted ground, ink foregrounds and teal interaction.",
      "Display sans for hierarchy, reading serif for prose, mono for technical metadata.",
      "Fine borders, gently rounded surfaces and restrained depth.",
      "Responsive navigation, readable measurements and visible investigation state."
    ],
    "rules": [
      {
        "name": "The Inherited Color Rule",
        "body": "Use the shared semantic colors for backgrounds, text, controls and chart marks; dark mode changes their values together.",
        "section": "colors"
      },
      {
        "name": "The Role Continuity Rule",
        "body": "Keep the existing display, reading and metadata stacks in their established roles; the statistics workspace uses the display stack for compact analytical content.",
        "section": "typography"
      },
      {
        "name": "The Surface Depth Rule",
        "body": "Project cards and site links carry the shared shadow. Workspace controls, notices and charts use borders and tonal separation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do inherit both light and dark semantic colors from the shared stylesheet.",
      "Do use tabular numerals for analytical counts, tables, timestamps and numerical controls.",
      "Do keep filter scope visible with a clear action when event filters are applied.",
      "Do adapt chart geometry to available width, retain readable labels and provide exact values in a table.",
      "Do retain visible focus, wrapping forms and horizontally accessible navigation on narrow screens."
    ],
    "donts": [
      "Don't introduce a new palette or type family for another personal-tool route.",
      "Don't turn a stale session response into the visible result after its investigation context changes.",
      "Don't shrink a fixed desktop chart wholesale until its labels become unreadable.",
      "Don't use elevation on every workspace section; ordinary sections are separated by spacing and fine rules."
    ]
  }
}
